# Copy this file to .env and fill in your key
# Get an OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Persistence (optional - leave unset to run fully in-memory, e.g. local dev) ---

# Supabase Postgres connection string. In Supabase: Project Settings ->
# Database -> Connection string -> "URI" tab, using the DIRECT connection
# (port 5432, not the 6543 pooler one - the pooler doesn't play well with
# SQLAlchemy's default connection handling for a long-lived server process).
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

# --- Cloud deployment only (leave unset for local dev) ---

# Comma-separated list of frontend URLs allowed to call this API.
# Example: ALLOWED_ORIGINS=https://my-team-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Shared team login (HTTP Basic Auth). Leave both unset to disable the
# login gate entirely (e.g. for local dev).
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
