# Copy this file to .env and fill in your key
# Get an OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Cloud deployment only (leave unset for local dev) ---

# Comma-separated list of frontend URLs allowed to call this API.
# Example: ALLOWED_ORIGINS=https://my-team-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Shared team login (HTTP Basic Auth). Leave both unset to disable the
# login gate entirely (e.g. for local dev).
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
